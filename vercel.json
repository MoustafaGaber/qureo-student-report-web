{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "regions": ["hnd1"],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://qureo-student-report.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://qureo-student-report.firebaseapp.com/__/firebase/:path*"
    }
  ],
  "functions": {
    "api/[...path].js": {
      "maxDuration": 300
    }
  }
}
