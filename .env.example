# Firebase web app settings (public client configuration)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Google Picker API key, restricted to the app's website and Google Picker API.
VITE_GOOGLE_PICKER_API_KEY=

# Must match VITE_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=

# Keep the downloaded Firebase Admin key outside Git. Use either path (local) or JSON (host environment).
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# Comma-separated teacher emails and/or allowed email domains; empty means no users can run checks.
ALLOWED_EMAILS=
ALLOWED_EMAIL_DOMAINS=

# Optional for hosting platforms; local defaults to 127.0.0.1.
HOST=
PORT=3456
